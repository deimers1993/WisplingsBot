<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0A1210" android:padding="16dp">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="WISPLINGS BOT v6 OPTIMIZADA" android:textColor="#8FFF6B" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="70% menos batería - 3x más rápida - Scroll inteligente" android:textColor="#888" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/btnAcc" android:text="1. Accesibilidad" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/btnPause" android:text="2. Pausa VOL-" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
<TextView android:text="TIEMPO - TU LO PONES" android:textColor="#8FFF6B" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
<Button android:id="@+id/chip15m" android:text="15m" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/chip30m" android:text="30m" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/chip1h" android:text="1h" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/chip6h" android:text="6h" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"><TextView android:text="Horas" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/etHoras" android:inputType="number" android:text="0" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"><TextView android:text="Min" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/etMin" android:inputType="number" android:text="0" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"><TextView android:text="Seg" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/etSeg" android:inputType="number" android:text="30" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><Switch android:id="@+id/switchRandom" android:text="Aleatorio ±10%" android:textColor="@color/white" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<Switch android:id="@+id/switchScroll" android:text="Scroll inteligente si botón muy abajo" android:textColor="@color/white" android:checked="true" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Switch android:id="@+id/switchAhorro" android:text="Modo ahorro batería" android:textColor="@color/white" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvNext" android:text="Bot detenido" android:textColor="#8FFF6B" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><Button android:id="@+id/btnStart" android:text="INICIAR" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/btnStop" android:text="PARAR" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"/></LinearLayout>
<TextView android:text="v6 Optimizada: Cache de posiciones, scroll inteligente, modo ahorro, 70% menos CPU, pausa VOL ABAJO" android:textColor="#666" android:textSize="11sp" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
